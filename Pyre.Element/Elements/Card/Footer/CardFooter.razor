@namespace Pyre.Element.Card
@using Pyre.Element.Enums

    @if (Variant == E_CARD_FOOTER.DataPoint)
{
    <div class="@ComputedWrapperClass" @attributes="AdditionalAttributes">
        <div class="@ComputedClass @ComputedDirectionClass">
            @PrimaryDataPoint
        </div>
    </div>
}
else if (Variant == E_CARD_FOOTER.DoubleDataPoint)
{
    <div class="double--data--points">
        <div class="@ComputedClass card--lateral--direction--left">
            @PrimaryDataPoint
        </div>
        <div class="@ComputedClass card--lateral--direction--right">
            @SecondaryDataPoint
        </div>
    </div>
}
else
{
    <div class="@ComputedWrapperClass" @attributes="AdditionalAttributes">
        @ChildContent
    </div>

}

@code {
    // Base
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
    // Pyre Base {
    [Parameter] public E_STATUS PrimaryDataStatus { get; set; } = E_STATUS.Neutral;
    [Parameter] public E_STATUS SecondaryDataStatus { get; set; } = E_STATUS.Neutral;
    [Parameter] public E_CARD_FOOTER Variant { get; set; } = E_CARD_FOOTER.Default;
    [Parameter] public E_DIRECTION_LATERAL LateralDirection { get; set; } = E_DIRECTION_LATERAL.Center;
    [Parameter] public string PrimaryDataPoint { get; set; } = "";
    [Parameter] public string SecondaryDataPoint { get; set; } = "";

    // |
    private string _primaryDataStatus => PrimaryDataStatus.ToString().ToLower();
    private string _secondaryDataStatus => SecondaryDataStatus.ToString().ToLower();
    private string _variant => Variant.ToString().ToLower();
    private string _lateralDirection => LateralDirection.ToString().ToLower();
    // }
    // Element Specific
    // ==========================================================================================================
    // Computed Classes & Styles
    public string ComputedWrapperClass =>
        $"card__footer card--variant--{_variant} card--wraper--lateral--direction--{_lateralDirection}";

    public string ComputedClass =>
        $"card--data--point card--data--status--primary--{_primaryDataStatus} card--data--status--secondary--{_secondaryDataStatus}";

    public string ComputedDirectionClass =>
        $"card--lateral--direction--{_lateralDirection}";

    public string ComputedStyle =>
        $"";
}