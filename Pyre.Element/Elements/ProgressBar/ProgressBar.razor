@namespace Pyre.Element.ProgressBar

<div class="progress__bar__wrapper" style="@ComputedWraperStyle">
    <div class="pb--complete" style="@ComputedCompleteStyle"></div>
    <div class="pb--incomplete" style="@ComputedIncompleteStyle"></div>
</div>

@code {
    // Base
    [Parameter] public double Complete { get; set; } = 0;
    [Parameter] public double Total { get; set; } = 100;
    // Pyre Base
    [Parameter] public E_COLOR_BASIC CompleteColor { get; set; } = E_COLOR_BASIC.Primary;
    [Parameter] public E_COLOR_BASIC IncompleteColor { get; set; } = E_COLOR_BASIC.OffWhite;
    [Parameter] public E_SIZE Size { get; set; } = E_SIZE.sm;
    // Element Specific
    private double CompletePercent => Total == 0 ? 0 : Math.Clamp((Complete / Total) * 100, 0, 100);
    private double IncompletePercent => 100 - CompletePercent;
    private double _size => Size switch
    {
        E_SIZE.xs => 0.35,
        E_SIZE.sm => 0.5,
        E_SIZE.md => 0.75,
        E_SIZE.lg => 1,
        E_SIZE.xl => 1.5,
        _ => 0.5
    };

    private string ComputedWraperStyle =>
        $"height: {_size.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}rem;";

    private string ComputedCompleteStyle =>
        $"width: {CompletePercent.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%; background-color: var(--color-{CompleteColor.ToString().ToLower()});";

    private string ComputedIncompleteStyle =>
        $"width: {IncompletePercent.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}%; background-color: var(--color-{IncompleteColor.ToString().ToLower()});";
}