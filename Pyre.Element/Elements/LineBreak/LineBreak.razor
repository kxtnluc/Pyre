@namespace Pyre.Element.LineBreak

<div class="line__break line__break--@_size @(Vertical ? "line__break--vertical" : "")" style="@ComputedStyles"></div>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public E_SIZE Size { get; set; } = E_SIZE.sm;
    [Parameter] public E_COLOR_BASIC Color { get; set; } = E_COLOR_BASIC.Primary;
    [Parameter] public string HexColor { get; set; } = "";
    [Parameter] public string Length { get; set; } = "100%";
    [Parameter] public bool Vertical { get; set; } = false;
    // |
    private string _size => Size.ToString().ToLower();
    private string _color => HexColor == string.Empty
        ? $"var(--color-{Color.ToString().ToLower()}-faded)"
        : HexColor;

    private string ComputedStyles => Vertical
        ? $"background-color: {_color}; height: {Length};"   // param repurposed as length
        : $"background-color: {_color}; width: {Length};";
}